# Copy this file to .env and fill in your real values.
# NEVER commit .env – it is in .gitignore.

# --- DagsHub / MLflow ---
DAGSHUB_USERNAME=your_dagshub_username
DAGSHUB_TOKEN=your_dagshub_token
MLFLOW_TRACKING_URI=https://dagshub.com/<username>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=your_dagshub_username
MLFLOW_TRACKING_PASSWORD=your_dagshub_token

# --- DVC remote (set automatically by DagsHub, shown here for reference) ---
DVC_REMOTE_URL=https://dagshub.com/<username>/<repo>.dvc

# --- API ---
API_RELOAD_SECRET=change_me_to_a_random_string

# --- Optional: local MLflow (only used in docker-compose dev override) ---
# MLFLOW_TRACKING_URI=http://localhost:5000

